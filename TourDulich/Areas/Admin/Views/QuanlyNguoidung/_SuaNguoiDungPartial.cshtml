@model TourDulich.Models.NguoiDung

<form id="formSuaNguoiDung">
    @Html.HiddenFor(m => m.ID_NguoiDung)

    <div class="form-group mb-3">
        <label>Tên đăng nhập</label>
        @Html.TextBoxFor(m => m.TaiKhoan, new { @class = "form-control", @readonly = "readonly" })
    </div>
    <div class="form-group mb-3">
        <label>Mật khẩu (để trống nếu không đổi)</label>
        @Html.TextBoxFor(m => m.MatKhau, new { @class = "form-control", type = "password", @Value = "", placeholder = "Nhập mật khẩu mới nếu muốn đổi..." })
    </div>

    <div class="form-group mb-3">
        <label>Họ tên</label>
        @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
    </div>
    <div class="form-group mb-3">
        <label>Email</label>
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
    </div>
    <div class="form-group mb-3">
        <label>SĐT</label>
        @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control" })
    </div>
    <div class="form-group mb-3">
        <label>Địa chỉ</label>
        @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
    </div>
    <button type="button" class="btn btn-primary" id="btnLuuNguoiDung">Lưu</button>
</form>
