@model TourDulich.Models.LichKhoiHanh
@{
    ViewBag.Title = "Thêm Lịch Khởi Hành";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-center mb-4 pt-2">➕ Thêm Lịch Khởi Hành</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                @using (Html.BeginForm("Create", "QuanlyLichKhoiHanh", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tour <span class="text-danger">*</span></label>
                        @Html.DropDownList("ID_Tour", (SelectList)ViewBag.Tours, "-- Chọn tour --", new { @class = "form-select" })
                        @Html.ValidationMessage("ID_Tour", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày khởi hành <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.NgayKhoiHanh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.NgayKhoiHanh, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số lượng tối đa <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SoLuongToiDa, new { @class = "form-control", type = "number", min = "1" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái</label>
                        @Html.DropDownListFor(m => m.TrangThai,
                            new SelectList(new[] { "Mở", "Đóng" }),
                            new { @class = "form-select" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú</label>
                        @Html.TextBoxFor(m => m.GhiChu, new { @class = "form-control" })
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save me-1"></i> Lưu
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
