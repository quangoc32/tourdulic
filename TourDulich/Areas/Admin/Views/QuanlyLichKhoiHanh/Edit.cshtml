@model TourDulich.Models.LichKhoiHanh
@{
    ViewBag.Title = "Sửa Lịch Khởi Hành";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-center mb-4 pt-2">✏️ Sửa Lịch Khởi Hành</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                @using (Html.BeginForm("Edit", "QuanlyLichKhoiHanh", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ID_LichKhoiHanh)
                    @Html.HiddenFor(m => m.ID_Tour)
                    @Html.HiddenFor(m => m.NgayKhoiHanh)
                    @Html.HiddenFor(m => m.SoLuongDaDat)

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tour</label>
                        @Html.DropDownList("ID_Tour", (SelectList)ViewBag.Tours, new { @class = "form-select", disabled = "disabled" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ngày khởi hành</label>
                        <input type="date" class="form-control" value="@Model.NgayKhoiHanh.ToString("yyyy-MM-dd")" disabled />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Đã đặt: <span class="text-danger">@Model.SoLuongDaDat</span></label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Số lượng tối đa <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.SoLuongToiDa, new { @class = "form-control", type = "number", min = Model.SoLuongDaDat })
                        <small class="text-muted">Tối thiểu bằng số đã đặt (@Model.SoLuongDaDat)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái</label>
                        @Html.DropDownListFor(m => m.TrangThai,
                            new SelectList(new[] { "Mở", "Đóng", "Hết chỗ" }, Model.TrangThai),
                            new { @class = "form-select" })
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú</label>
                        @Html.TextBoxFor(m => m.GhiChu, new { @class = "form-control" })
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                        <a href="@Url.Action("Index", new { tourId = Model.ID_Tour })" class="btn btn-secondary">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
