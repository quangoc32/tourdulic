@model TourDulich.Models.DanhMuc

<form id="formSuaDanhMuc">
    @Html.HiddenFor(m => m.ID_DanhMuc)
    <div class="form-group mb-3">
        <label>Tên Danh Mục <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group mb-3">
        <label>Mô tả ngắn</label>
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
    </div>
    <button type="button" class="btn btn-warning text-dark fw-bold" id="btnLuuSua">Lưu Thay Đổi</button>
</form>
