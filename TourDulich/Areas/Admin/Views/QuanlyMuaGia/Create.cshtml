@model TourDulich.Models.MuaGia
@{
    bool isEdit = Model.ID_MuaGia > 0;
    ViewBag.Title = isEdit ? "Sửa Mùa Giá" : "Thêm Mùa Giá";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-center mb-4 pt-2">@(isEdit ? "✏️ Sửa" : "➕ Thêm") Mùa Giá</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body p-4">
                @{ var action = isEdit ? "Edit" : "Create"; }
                @using (Html.BeginForm(action, "QuanlyMuaGia", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ID_MuaGia)

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên mùa <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.TenMua, new { @class = "form-control", placeholder = "VD: Hè 2025, Tết Nguyên Đán 2026" })
                        @Html.ValidationMessageFor(m => m.TenMua, "", new { @class = "text-danger small" })
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Từ ngày <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.NgayBatDau, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Đến ngày <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.NgayKetThuc, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.NgayKetThuc, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Hệ số giá <span class="text-danger">*</span></label>
                        <input type="number" name="HeSoGia" id="HeSoGia" class="form-control" step="0.05" min="0.1" max="5" required 
                               value="@Model.HeSoGia.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                        @Html.ValidationMessageFor(m => m.HeSoGia, "", new { @class = "text-danger small" })
                        <small class="text-muted">
                            1.00 = giữ nguyên &nbsp;|&nbsp; 1.30 = tăng 30% &nbsp;|&nbsp; 0.80 = giảm 20%
                        </small>
                        <div class="mt-2">
                            <span class="fw-bold">Ví dụ:</span> Tour giá gốc <strong>5.000.000đ</strong> với hệ số
                            <span id="previewHeSo">@Model.HeSoGia.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</span> →
                            <strong id="previewGia" class="text-primary">@((5000000 * (double)Model.HeSoGia).ToString("N0"))đ</strong>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả</label>
                        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "2" })
                    </div>
                    <div class="mb-3 form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        <label class="form-check-label fw-bold">Kích hoạt</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-save me-1"></i> Lưu
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.querySelector('[name="HeSoGia"]').addEventListener('input', function () {
    var hs = parseFloat(this.value) || 1;
    document.getElementById('previewHeSo').textContent = hs.toFixed(2);
    document.getElementById('previewGia').textContent = (5000000 * hs).toLocaleString('vi-VN') + 'đ';
});
</script>
}
