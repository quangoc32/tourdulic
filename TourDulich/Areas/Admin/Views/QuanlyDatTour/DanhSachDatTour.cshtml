@using TourDulich.Models
@{
    ViewBag.Title = "Quản lý Đặt Tour";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="text-center mb-4 pt-2">Quản lý Đặt Tour</h2>

<div class="d-flex justify-content-end mb-3">
    <form method="get" action="@Url.Action("DanhSachDatTour", "QuanlyDatTour")" class="d-flex w-25">
        <input type="text" name="searchString" class="form-control me-2" placeholder="Tìm tên, email, SĐT..." value="@ViewBag.SearchString" />
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
    </form>
</div>

<table class="table table-bordered table-hover text-center align-middle">
    <thead class="thead-dark">
        <tr>
            <th>Người Đặt</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Loại đặt</th>
            <th>Trạng Thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            bool canConfirmPickup = item.TrangThai == AppConstants.TrangThaiDatTour.ChoXacNhanDiemDon;
            bool isPending = item.TrangThai == AppConstants.TrangThaiDatTour.ChoXuLy
                || item.TrangThai == AppConstants.TrangThaiDatTour.YeuCauDoanChoXacNhan
                || item.TrangThai == AppConstants.TrangThaiDatTour.ChoThanhToan
                || canConfirmPickup;

            <tr class="@(item.LaDoan ? "table-success" : "")">
                <td>
                    @item.TenNguoiDung
                    @if (item.LaDoan && !string.IsNullOrEmpty(item.TruongDoan))
                    {
                        <br /><small class="text-muted"><i class="bi bi-person-badge me-1"></i>Trưởng đoàn: <strong>@item.TruongDoan</strong> - @item.SdtTruongDoan</small>
                    }
                </td>
                <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                <td><strong>@item.TongTien.ToString("N0")</strong> VNĐ</td>
                <td>
                    @if (item.LaDoan)
                    {
                        <span class="badge bg-success"><i class="bi bi-people-fill me-1"></i>Đoàn</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="bi bi-person-fill me-1"></i>Khách lẻ</span>
                    }
                </td>
                <td>
                    @if (isPending)
                    {
                        <span class="badge" style="background-color: #f1c40f; color: #000;">@item.TrangThai</span>
                    }
                    else if (item.TrangThai == AppConstants.TrangThaiDatTour.DaXacNhan)
                    {
                        <span class="badge" style="background-color: #00c851; color: #fff;">@item.TrangThai</span>
                    }
                    else
                    {
                        <span class="badge" style="background-color: #ff0000; color: #fff;">@item.TrangThai</span>
                    }
                </td>
                <td>
                    @if (isPending)
                    {
                        <button class="btn btn-primary btn-sm btnXuLyDatTour"
                                data-id="@item.ID_DatTour"
                                data-can-confirm-pickup="@canConfirmPickup.ToString().ToLower()"
                                data-can-update="@((item.TrangThai != AppConstants.TrangThaiDatTour.DaHuy).ToString().ToLower())">
                            <i class="bi bi-gear"></i> Xử lý
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-info btn-sm btnXuLyDatTour"
                                data-id="@item.ID_DatTour"
                                data-can-confirm-pickup="false"
                                data-can-update="false"
                                data-readonly="true">
                            <i class="bi bi-eye"></i> Chi tiết
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="modalChiTiet" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title"><i class="bi bi-gear-fill me-2"></i>Xử lý đơn đặt tour</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="contentChiTiet"></div>
                <div id="inlineCapNhatTrangThai" class="mt-4 border rounded-3 bg-light p-3" style="display:none;">
                    <input type="hidden" id="inlineInputID" />
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="mb-0 fw-bold text-primary"><i class="bi bi-pencil-square me-1"></i>Cập nhật trạng thái đơn</h6>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnHuyInlineCapNhat">
                            <i class="bi bi-x-lg me-1"></i>Ẩn
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">Trạng thái</label>
                            <select class="form-select" id="inlineTrangThai">
                                <option>@AppConstants.TrangThaiDatTour.ChoXuLy</option>
                                <option>@AppConstants.TrangThaiDatTour.ChoXacNhanDiemDon</option>
                                <option>@AppConstants.TrangThaiDatTour.ChoThanhToan</option>
                                <option>@AppConstants.TrangThaiDatTour.YeuCauDoanChoXacNhan</option>
                                <option>@AppConstants.TrangThaiDatTour.DaXacNhan</option>
                                <option>@AppConstants.TrangThaiDatTour.DaHuy</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold">Ghi chú</label>
                            <textarea class="form-control" id="inlineGhiChu" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
                        <span class="text-success small fw-semibold me-auto" id="inlineCapNhatMessage" style="display:none;"></span>
                        <button type="button" class="btn btn-primary btn-sm" id="btnLuuInlineCapNhat">
                            <i class="bi bi-save-fill me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <div class="text-muted small">Kiểm tra chi tiết trước khi cập nhật trạng thái hoặc xác nhận điểm đón.</div>
                <div class="d-flex gap-2 flex-wrap justify-content-end">
                    <button type="button" class="btn btn-success btn-sm" id="modalActionXacNhanDiemDon">
                        <i class="bi bi-geo-alt-fill me-1"></i>Xác nhận điểm đón
                    </button>
                    <button type="button" class="btn btn-warning btn-sm" id="modalActionCapNhat">
                        <i class="bi bi-pencil-square me-1"></i>Cập nhật trạng thái
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" id="modalActionXoa">
                        <i class="bi bi-trash-fill me-1"></i>Xóa đơn
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalSuaTrangThai" tabindex="-1" role="dialog" aria-labelledby="modalSuaTrangThaiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <form id="formSuaTrangThai">
                <div class="modal-header bg-primary text-white" style="border-radius: 15px 15px 0 0;">
                    <h5 class="modal-title" id="modalSuaTrangThaiLabel"><i class="bi bi-pencil-square me-2"></i>Sửa Trạng Thái Đặt Tour</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="ID_DatTour" id="inputID" />
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng Thái</label>
                        <select name="TrangThai" class="form-select" id="inputTrangThai">
                            <option>@AppConstants.TrangThaiDatTour.ChoXuLy</option>
                            <option>@AppConstants.TrangThaiDatTour.ChoXacNhanDiemDon</option>
                            <option>@AppConstants.TrangThaiDatTour.ChoThanhToan</option>
                            <option>@AppConstants.TrangThaiDatTour.YeuCauDoanChoXacNhan</option>
                            <option>@AppConstants.TrangThaiDatTour.DaXacNhan</option>
                            <option>@AppConstants.TrangThaiDatTour.DaHuy</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi Chú</label>
                        <textarea name="GhiChu" class="form-control" id="inputGhiChu" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill me-1"></i> Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalXacNhanDiemDon" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-success text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title"><i class="bi bi-geo-alt-fill me-2"></i>Xác nhận điểm đón</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="inputDiemDonDatTourId" />
                <div class="alert alert-info small">
                    Nhập phụ thu theo mỗi người. Sau khi xác nhận, đơn sẽ chuyển sang <strong>Chờ thanh toán</strong>.
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Phụ thu điểm đón / người</label>
                    <input type="number" class="form-control" id="inputPhuThuDiemDon" value="0" min="0" step="1000" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Ghi chú cho khách</label>
                    <textarea class="form-control" id="inputGhiChuDiemDon" rows="3" placeholder="VD: Xe có thể đón tại Gang Thép, phụ thu 100.000đ/người."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-success" id="btnSubmitXacNhanDiemDon">
                    <i class="bi bi-check-circle me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalXacNhanXoa" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-danger text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                <p class="mt-3 fs-5">Bạn có chắc chắn muốn xóa đơn đặt tour này không?</p>
                <p class="text-muted small">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" class="btn btn-danger" id="btnXacNhanXoa"><i class="bi bi-trash-fill me-1"></i> Xóa ngay</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentDatTourId = 0;
            let currentCanConfirmPickup = false;
            let currentCanUpdate = false;
            let currentReadOnly = false;
            let idXoa = 0;
            const statusDaXacNhan = '@AppConstants.TrangThaiDatTour.DaXacNhan';
            const statusDaHuy = '@AppConstants.TrangThaiDatTour.DaHuy';

            function anFormCapNhatTrangThai() {
                $("#inlineCapNhatTrangThai").hide();
                $("#inlineCapNhatMessage").hide().text("");
            }

            function taiLaiChiTietDatTour(callback) {
                $.get('@Url.Action("GetChiTietDatTourPartial", "QuanlyDatTour", new { area = "Admin" })', { id: currentDatTourId }, function (data) {
                    $("#contentChiTiet").html(data);
                    if (typeof callback === "function") {
                        callback();
                    }
                });
            }

            $(".btnXuLyDatTour").click(function () {
                var id = $(this).data("id");
                currentDatTourId = id;
                currentCanConfirmPickup = $(this).data("can-confirm-pickup") === true || $(this).data("can-confirm-pickup") === "true";
                currentCanUpdate = $(this).data("can-update") === true || $(this).data("can-update") === "true";
                currentReadOnly = $(this).data("readonly") === true || $(this).data("readonly") === "true";
                anFormCapNhatTrangThai();

                taiLaiChiTietDatTour(function () {
                    $("#modalActionXacNhanDiemDon").toggle(!currentReadOnly && currentCanConfirmPickup);
                    $("#modalActionCapNhat").toggle(!currentReadOnly && currentCanUpdate);
                    $("#modalActionXoa").toggle(!currentReadOnly);
                    $("#modalChiTiet").modal("show");
                });
            });

            $("#modalActionXacNhanDiemDon").click(function () {
                $("#modalChiTiet").modal("hide");
                $("#inputDiemDonDatTourId").val(currentDatTourId);
                $("#inputPhuThuDiemDon").val(0);
                $("#inputGhiChuDiemDon").val("");
                $("#modalXacNhanDiemDon").modal("show");
            });

            $("#modalActionCapNhat").click(function () {
                anFormCapNhatTrangThai();
                $.get('@Url.Action("GetTrangThaiDatTour", "QuanlyDatTour", new { area = "Admin" })', { id: currentDatTourId }, function (res) {
                    if (res.success) {
                        $("#inlineInputID").val(res.ID_DatTour);
                        $("#inlineTrangThai").val(res.TrangThai);
                        $("#inlineGhiChu").val(res.GhiChu);
                        $("#inlineCapNhatTrangThai").slideDown(150);
                    } else {
                        alert("Không lấy được dữ liệu.");
                    }
                });
            });

            $("#btnHuyInlineCapNhat").click(function () {
                anFormCapNhatTrangThai();
            });

            $("#btnLuuInlineCapNhat").click(function () {
                const trangThaiMoi = $("#inlineTrangThai").val();
                const $button = $(this);
                $button.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang lưu');

                $.post('@Url.Action("CapNhatTrangThai", "QuanlyDatTour", new { area = "Admin" })', {
                    ID_DatTour: $("#inlineInputID").val(),
                    TrangThai: trangThaiMoi,
                    GhiChu: $("#inlineGhiChu").val()
                }, function (res) {
                    if (res.success) {
                        $("#inlineCapNhatMessage").text("Đã lưu trạng thái. Chi tiết đơn đã được cập nhật.").show();
                        taiLaiChiTietDatTour(function () {
                            if (trangThaiMoi === statusDaXacNhan || trangThaiMoi === statusDaHuy) {
                                currentReadOnly = true;
                                currentCanUpdate = false;
                                currentCanConfirmPickup = false;
                                $("#modalActionXacNhanDiemDon").hide();
                                $("#modalActionCapNhat").hide();
                                $("#modalActionXoa").hide();
                                anFormCapNhatTrangThai();
                            }
                        });
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                }).always(function () {
                    $button.prop("disabled", false).html('<i class="bi bi-save-fill me-1"></i>Lưu thay đổi');
                });
            });

            $("#modalActionXoa").click(function () {
                $("#modalChiTiet").modal("hide");
                idXoa = currentDatTourId;
                $("#modalXacNhanXoa").modal("show");
            });

            $(".btnSuaTrangThai").click(function () {
                const id = $(this).data("id");
                $.get('@Url.Action("GetTrangThaiDatTour", "QuanlyDatTour", new { area = "Admin" })', { id: id }, function (res) {
                    if (res.success) {
                        $("#inputID").val(res.ID_DatTour);
                        $("#inputTrangThai").val(res.TrangThai);
                        $("#inputGhiChu").val(res.GhiChu);
                        $("#modalSuaTrangThai").modal("show");
                    } else {
                        alert("Không lấy được dữ liệu.");
                    }
                });
            });

            $("#formSuaTrangThai").submit(function (e) {
                e.preventDefault();
                $.post('@Url.Action("CapNhatTrangThai", "QuanlyDatTour", new { area = "Admin" })', $(this).serialize(), function (res) {
                    if (res.success) {
                        alert("Cập nhật thành công!");
                        $("#modalSuaTrangThai").modal("hide");
                        location.reload();
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                });
            });

            $(document).on("click", ".btnXoaDatTour", function () {
                idXoa = $(this).data("id");
                $("#modalXacNhanXoa").modal("show");
            });

            $("#btnXacNhanXoa").click(function () {
                $.post('@Url.Action("XoaDatTour", "QuanlyDatTour", new { area = "Admin" })', { id: idXoa }, function (res) {
                    if (res.success) {
                        $("#modalXacNhanXoa").modal("hide");
                        alert("Xóa thành công!");
                        location.reload();
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                });
            });

            $(document).on("click", ".btnXacNhanDiemDon", function () {
                const box = $(this).closest(".pickup-confirm-box");
                $.post('@Url.Action("XacNhanDiemDon", "QuanlyDatTour", new { area = "Admin" })', {
                    idChiTietDatTour: box.find(".ct-id").val(),
                    phuThuDiemDon: box.find(".pickup-fee").val(),
                    ghiChuDiemDon: box.find(".pickup-note").val()
                }, function (res) {
                    if (res.success) {
                        alert("Đã xác nhận điểm đón. Đơn đã chuyển sang chờ khách thanh toán.");
                        location.reload();
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                });
            });

            $(document).on("click", ".btnXacNhanDiemDonDon", function () {
                $("#inputDiemDonDatTourId").val($(this).data("id"));
                $("#inputPhuThuDiemDon").val(0);
                $("#inputGhiChuDiemDon").val("");
                $("#modalXacNhanDiemDon").modal("show");
            });

            $("#btnSubmitXacNhanDiemDon").click(function () {
                $.post('@Url.Action("XacNhanDiemDonTheoDon", "QuanlyDatTour", new { area = "Admin" })', {
                    idDatTour: $("#inputDiemDonDatTourId").val(),
                    phuThuDiemDon: $("#inputPhuThuDiemDon").val(),
                    ghiChuDiemDon: $("#inputGhiChuDiemDon").val()
                }, function (res) {
                    if (res.success) {
                        alert("Đã xác nhận điểm đón. Đơn đã chuyển sang chờ khách thanh toán.");
                        $("#modalXacNhanDiemDon").modal("hide");
                        location.reload();
                    } else {
                        alert("Lỗi: " + res.message);
                    }
                });
            });
        });
    </script>
}

