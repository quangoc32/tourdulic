@model List<TourDulich.Models.LichTrinhTour>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="thead-dark">
            <tr>
                <th style="width: 120px; text-align: center;">Ngày Thứ</th>
                <th style="width: 250px;">Tiêu Đề</th>
                <th>Nội Dung</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td style="text-align: center; vertical-align: middle;">@item.NgayThu</td>
                        <td style="vertical-align: middle;">@item.TieuDe</td>
                        <td style="white-space: pre-wrap;">@item.NoiDung</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted font-italic">Chưa có lịch trình cho tour này.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
