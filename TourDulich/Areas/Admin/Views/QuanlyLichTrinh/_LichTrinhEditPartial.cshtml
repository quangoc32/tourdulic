<form id="formSuaLichTrinh">
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="width: 100px; text-align: center;">Ngày Thứ</th>
                <th style="width: 200px;">Tiêu Đề</th>
                <th>Nội Dung</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td style="text-align:center; vertical-align: middle;">
                        @Model[i].NgayThu
                        <input type="hidden" name="model[@i].NgayThu" value="@Model[i].NgayThu" />
                        <input type="hidden" name="model[@i].ID_LichTrinhTour" value="@Model[i].ID_LichTrinhTour" />
                        <input type="hidden" name="model[@i].ID_Tour" value="@Model[i].ID_Tour" />
                    </td>
                    <td>
                        <textarea name="model[@i].TieuDe" class="form-control" rows="3">@Model[i].TieuDe </textarea>
                    </td>
                    <td>
                        <textarea name="model[@i].NoiDung" class="form-control" rows="3">@Model[i].NoiDung</textarea>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" id="btnLuuLichTrinh" class="btn btn-primary">Lưu Lịch Trình</button>
</form>
