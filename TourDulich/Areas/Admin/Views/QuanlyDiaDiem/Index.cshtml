@{
    ViewBag.Title = "Quản lý địa điểm";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

@model List<TourDulich.Models.DiaDiem>

<h2 class="text-center mb-4 pt-2">Quản lý địa điểm</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalThemDiaDiem">
        <i class="bi bi-plus-circle"></i> Thêm Địa Điểm Mới
    </button>
    
    <form method="get" action="@Url.Action("Index", "QuanlyDiaDiem")" class="d-flex w-25">
        <input type="text" name="searchString" class="form-control me-2" placeholder="Tìm tên địa điểm..." value="@ViewBag.SearchString" />
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i></button>
    </form>
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Tên Địa Điểm</th>
            <th>Tỉnh Thành</th>
            <th>Mô Tả</th>
            <th style="width: 140px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.TenDiaDiem</td>
                <td>@item.TinhThanh</td>
                <td>@item.MoTa</td>
                <td>
                    <button class="btn btn-warning btn-sm btnSuaDiaDiem" data-id="@item.ID_DiaDiem">Sửa</button>
                    <button class="btn btn-danger btn-sm btnXoaDiaDiem" data-id="@item.ID_DiaDiem">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Thêm Địa Điểm -->
<div class="modal fade" id="modalThemDiaDiem" tabindex="-1" aria-labelledby="modalThemLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title" id="modalThemLabel"><i class="bi bi-plus-circle-fill me-2"></i>Thêm Địa Điểm Mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formThemDiaDiem">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Địa Điểm / Quốc Gia <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="TenDiaDiem" required placeholder="VD: Đà Lạt, Nhật Bản, Hàn Quốc...">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tỉnh Thành</label>
                        <input type="text" class="form-control" name="TinhThanh" placeholder="VD: Lâm Đồng (nếu có)">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mô tả ngắn</label>
                        <textarea class="form-control" name="MoTa" rows="3" placeholder="Nhập mô tả..."></textarea>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-primary" id="btnLuuThem"><i class="bi bi-save-fill me-1"></i> Lưu Địa Điểm</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa Địa Điểm -->
<div class="modal fade" id="modalSuaDiaDiem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 15px;">
            <div class="modal-header bg-primary text-white" style="border-radius: 15px 15px 0 0;">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Sửa Địa Điểm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="contentSuaDiaDiem">
                <!-- Partial view content -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Thêm
        $(document).on("click", "#btnLuuThem", function () {
            var form = $("#formThemDiaDiem");
            if (!form[0].checkValidity()) {
                form[0].reportValidity();
                return;
            }
            $.post('@Url.Action("ThemDiaDiemAjax", "QuanlyDiaDiem", new { area = "Admin" })', form.serialize(), function (res) {
                if (res.success) {
                    alert("Thêm thành công!");
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            });
        });

        // Sửa
        $(document).on("click", ".btnSuaDiaDiem", function () {
            var id = $(this).data("id");
            $.get('@Url.Action("SuaDiaDiemPartial", "QuanlyDiaDiem", new { area = "Admin" })', { id: id }, function (html) {
                $("#contentSuaDiaDiem").html(html);
                $("#modalSuaDiaDiem").modal("show");
            });
        });

        $(document).on("click", "#btnLuuSua", function () {
            var form = $("#formSuaDiaDiem");
            $.post('@Url.Action("LuuSuaDiaDiem", "QuanlyDiaDiem", new { area = "Admin" })', form.serialize(), function (res) {
                if (res.success) {
                    alert("Cập nhật thành công!");
                    location.reload();
                } else {
                    alert("Lỗi: " + res.message);
                }
            });
        });

        // Xóa
        $(document).on("click", ".btnXoaDiaDiem", function () {
            if (!confirm("Bạn có chắc muốn xóa địa điểm này? (Sẽ báo lỗi nếu địa điểm này đã có Tour đặt)")) return;
            var id = $(this).data("id");
            $.post('@Url.Action("XoaDiaDiem", "QuanlyDiaDiem", new { area = "Admin" })', { id: id }, function (res) {
                if (res.success) {
                    alert("Đã xóa!");
                    location.reload();
                } else {
                    alert("Lỗi khi xóa: " + res.message);
                }
            });
        });
    </script>
}
