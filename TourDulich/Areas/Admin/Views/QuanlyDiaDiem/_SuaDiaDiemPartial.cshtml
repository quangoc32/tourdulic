@model TourDulich.Models.DiaDiem

<form id="formSuaDiaDiem">
    @Html.HiddenFor(m => m.ID_DiaDiem)
    <div class="form-group mb-3">
        <label>Tên Địa Điểm / Quốc Gia <span class="text-danger">*</span></label>
        @Html.TextBoxFor(m => m.TenDiaDiem, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group mb-3">
        <label>Tỉnh Thành</label>
        @Html.TextBoxFor(m => m.TinhThanh, new { @class = "form-control" })
    </div>
    <div class="form-group mb-3">
        <label>Mô tả ngắn</label>
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
    </div>
    <button type="button" class="btn btn-warning text-dark fw-bold" id="btnLuuSua">Lưu Thay Đổi</button>
</form>
