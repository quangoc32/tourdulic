<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #f4f9fd;
        }

        .sidebar {
            min-width: 250px;
            max-width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: linear-gradient(180deg, #1e3a8a 0%, #3b82f6 100%);
            color: white;
            padding-top: 70px;
            overflow-y: auto;
            box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            z-index: 100;
        }

            .sidebar a {
                color: #e0f2fe;
                text-decoration: none;
                display: block;
                padding: 12px 20px;
                margin: 8px 15px;
                border-radius: 15px;
                transition: all 0.3s ease;
                font-weight: 500;
            }

                .sidebar a:hover, .sidebar a.active {
                    background-color: rgba(255, 255, 255, 0.25);
                    color: white;
                    transform: translateY(-3px);
                    box-shadow: 0 6px 15px rgba(0,0,0,0.2);
                }

        .content-wrapper {
            margin-left: 250px;
            padding: 30px;
            flex-grow: 1;
            background-color: #f4f9fd;
            min-height: calc(100vh - 56px);
        }

        .navbar {
            background-color: #1e3a8a !important;
            box-shadow: 0 2px 15px rgba(0,0,0,0.15);
            z-index: 105;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        footer {
            text-align: center;
            padding: 15px 0;
            background: #e0f2fe;
            color: #1e3a8a;
            margin-top: auto;
            font-weight: 500;
        }

        /* Nút bo tròn và hiệu ứng 3D */
        .btn {
            border-radius: 12px !important;
            transition: all 0.3s ease !important;
        }

        .btn:hover {
            transform: translateY(-3px) !important;
            box-shadow: 0 6px 12px rgba(0,0,0,0.2) !important;
        }

        /* Bảng bo tròn mềm mại */
        .table {
            background-color: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        
        .table thead th {
            background-color: #e0f2fe;
            color: #1e3a8a;
            border-bottom: none;
        }

        .admin-notification-wrap {
            position: relative;
        }

        .admin-notification-btn {
            width: 38px;
            height: 38px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .admin-notification-btn:hover,
        .admin-notification-btn.show {
            background: rgba(255, 255, 255, 0.16);
        }

        .admin-notification-panel {
            width: 390px;
            max-height: calc(100vh - 90px);
            overflow-y: auto;
            border: 0;
            border-radius: 14px;
            padding: 12px;
            box-shadow: 0 18px 40px rgba(0,0,0,0.25);
        }

        .dropdown-menu-end.admin-notification-panel[data-bs-popper] {
            right: -120px;
        }

        .notification-title {
            font-size: 1.35rem;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

        .notification-item {
            display: flex;
            gap: 12px;
            padding: 10px;
            border-radius: 12px;
            color: #111827;
            text-decoration: none;
        }

        .notification-item:hover {
            background: #f1f5f9;
            color: #111827;
        }

        .notification-icon {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex: 0 0 auto;
        }

        .notification-text {
            line-height: 1.25;
            font-size: 0.92rem;
        }

        .notification-time {
            color: #2563eb;
            font-size: 0.8rem;
            margin-top: 3px;
        }

        .notification-dot {
            width: 9px;
            height: 9px;
            background: #2563eb;
            border-radius: 50%;
            margin-left: auto;
            align-self: center;
            flex: 0 0 auto;
        }

        .notification-empty {
            color: #64748b;
            padding: 24px 10px;
            text-align: center;
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand ps-3" href="@Url.Action("Index", "Admin")">
                <i class="bi bi-speedometer2 me-2"></i>Trang Quản Trị
            </a>
            <div class="d-flex align-items-center">
                @{
                    int pendingDatTourCount = 0;
                    int pendingCancelCount = 0;
                    int unreadContacts = 0;
                    var datTourNotifications = new List<TourDulich.Models.DatTour>();
                    var cancelNotifications = new List<TourDulich.Models.YeuCauHuy>();
                    var contactNotifications = new List<TourDulich.Models.LienHe>();

                    try {
                        using(var db = new TourDulich.Models.ModelDB()) {
                            var pendingDatTourStatuses = new[] {
                                TourDulich.Models.AppConstants.TrangThaiDatTour.ChoXuLy,
                                TourDulich.Models.AppConstants.TrangThaiDatTour.YeuCauDoanChoXacNhan,
                                TourDulich.Models.AppConstants.TrangThaiDatTour.ChoXacNhanDiemDon
                            };

                            pendingDatTourCount = db.DatTours.Count(d => pendingDatTourStatuses.Contains(d.TrangThai));
                            pendingCancelCount = db.YeuCauHuys.Count(y => y.TrangThai == TourDulich.Models.AppConstants.TrangThaiYeuCauHuy.ChoXuLy);
                            unreadContacts = db.LienHes.Count(l => l.TrangThai == "Chưa xử lý");

                            datTourNotifications = db.DatTours
                                .Include("NguoiDung")
                                .Where(d => pendingDatTourStatuses.Contains(d.TrangThai))
                                .OrderByDescending(d => d.NgayDat)
                                .Take(20)
                                .ToList();

                            cancelNotifications = db.YeuCauHuys
                                .Include("DatTour.NguoiDung")
                                .Where(y => y.TrangThai == TourDulich.Models.AppConstants.TrangThaiYeuCauHuy.ChoXuLy)
                                .OrderByDescending(y => y.NgayGui)
                                .Take(20)
                                .ToList();

                            contactNotifications = db.LienHes
                                .Where(l => l.TrangThai == "Chưa xử lý")
                                .OrderByDescending(l => l.NgayGui)
                                .Take(20)
                                .ToList();
                        }
                    } catch {}

                    int totalNotifications = pendingDatTourCount + pendingCancelCount + unreadContacts;
                }
                <div class="dropdown admin-notification-wrap me-3">
                    <button class="admin-notification-btn position-relative" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Thông báo">
                        <i class="bi bi-bell-fill" style="font-size: 1.2rem;"></i>
                        @if(totalNotifications > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; padding: 0.35em 0.5em;">
                                @(totalNotifications > 99 ? "99+" : totalNotifications.ToString())
                            </span>
                        }
                    </button>

                    <div class="dropdown-menu dropdown-menu-end admin-notification-panel">
                        <div class="d-flex align-items-center justify-content-between px-2 pb-2">
                            <h5 class="notification-title">Thông báo</h5>
                            <span class="badge bg-primary rounded-pill">@totalNotifications mới</span>
                        </div>

                        @if (totalNotifications == 0)
                        {
                            <div class="notification-empty">
                                <i class="bi bi-bell-slash d-block mb-2" style="font-size: 2rem;"></i>
                                Chưa có thông báo mới
                            </div>
                        }
                        else
                        {
                            int visibleNotificationLimit = 6;
                            int renderedNotificationCount = 0;
                            int loadedNotificationCount = datTourNotifications.Count + cancelNotifications.Count + contactNotifications.Count;
                            int hiddenNotificationCount = Math.Max(loadedNotificationCount - visibleNotificationLimit, 0);

                            if (datTourNotifications.Any())
                            {
                                <div class="px-2 pt-2 pb-1 fw-bold text-muted small text-uppercase">Đơn đặt tour</div>
                                foreach (var item in datTourNotifications)
                                {
                                    var customerName = item.NguoiDung != null ? item.NguoiDung.HoTen : "Khách hàng";
                                    renderedNotificationCount++;
                                    bool hideNotification = renderedNotificationCount > visibleNotificationLimit;
                                    <a class="notification-item @(hideNotification ? "admin-extra-notification d-none" : "")" href="@Url.Action("DanhSachDatTour", "QuanlyDatTour")">
                                        <span class="notification-icon bg-primary"><i class="bi bi-journal-check"></i></span>
                                        <span class="notification-text">
                                            <strong>@customerName</strong> có đơn đặt tour cần xử lý.
                                            <span class="d-block text-muted">@item.TrangThai - @((item.TongTien ?? 0).ToString("N0")) VNĐ</span>
                                            <span class="notification-time">@(item.NgayDat.HasValue ? item.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
                                        </span>
                                        <span class="notification-dot"></span>
                                    </a>
                                }
                            }

                            if (cancelNotifications.Any())
                            {
                                <div class="px-2 pt-2 pb-1 fw-bold text-muted small text-uppercase">Yêu cầu hủy tour</div>
                                foreach (var item in cancelNotifications)
                                {
                                    var customerName = item.DatTour != null && item.DatTour.NguoiDung != null ? item.DatTour.NguoiDung.HoTen : "Khách hàng";
                                    renderedNotificationCount++;
                                    bool hideNotification = renderedNotificationCount > visibleNotificationLimit;
                                    <a class="notification-item @(hideNotification ? "admin-extra-notification d-none" : "")" href="@Url.Action("Index", "QuanlyYeuCauHuy")">
                                        <span class="notification-icon bg-danger"><i class="bi bi-x-circle"></i></span>
                                        <span class="notification-text">
                                            <strong>@customerName</strong> vừa gửi yêu cầu hủy tour.
                                            <span class="d-block text-muted">@item.LyDo</span>
                                            <span class="notification-time">@item.NgayGui.ToString("dd/MM/yyyy HH:mm")</span>
                                        </span>
                                        <span class="notification-dot"></span>
                                    </a>
                                }
                            }

                            if (contactNotifications.Any())
                            {
                                <div class="px-2 pt-2 pb-1 fw-bold text-muted small text-uppercase">Liên hệ</div>
                                foreach (var item in contactNotifications)
                                {
                                    renderedNotificationCount++;
                                    bool hideNotification = renderedNotificationCount > visibleNotificationLimit;
                                    <a class="notification-item @(hideNotification ? "admin-extra-notification d-none" : "")" href="@Url.Action("Index", "QuanlyLienHe")">
                                        <span class="notification-icon bg-info"><i class="bi bi-envelope"></i></span>
                                        <span class="notification-text">
                                            <strong>@item.HoTen</strong> gửi liên hệ mới.
                                            <span class="d-block text-muted">@item.TieuDe</span>
                                            <span class="notification-time">@(item.NgayGui.HasValue ? item.NgayGui.Value.ToString("dd/MM/yyyy HH:mm") : "")</span>
                                        </span>
                                        <span class="notification-dot"></span>
                                    </a>
                                }
                            }

                            if (hiddenNotificationCount > 0)
                            {
                                <div class="d-grid px-2 pt-2">
                                    <button type="button" class="btn btn-sm btn-light admin-show-more-notifications">
                                        Xem thêm thông báo (@hiddenNotificationCount)
                                    </button>
                                </div>
                            }

                            <div class="d-grid gap-2 px-2 pt-2">
                                <a class="btn btn-sm btn-primary" href="@Url.Action("DanhSachDatTour", "QuanlyDatTour")">Xem đơn đặt tour</a>
                                <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Index", "QuanlyYeuCauHuy")">Xem yêu cầu hủy</a>
                            </div>
                        }
                    </div>
                </div>
                <span class="me-3 text-white">Xin chào, @(Session["AdminName"] ?? "Admin")</span>
                <a class="btn btn-outline-light btn-sm" href="@Url.Action("Logout", "Dangnhap")">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </a>
            </div>
        </div>
    </nav>

    <div class="sidebar">
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "HomeAdmin" ? "active" : "")" href="@Url.Action("Index", "HomeAdmin")">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyTour" ? "active" : "")" href="@Url.Action("Index", "QuanlyTour")">
                <i class="bi bi-geo-alt-fill me-2"></i> Quản lý Tour
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyLichTrinh" ? "active" : "")" href="@Url.Action("Index", "QuanlyLichTrinh")">
                <i class="bi bi-journal-check me-2"></i>Lịch Trình Tour
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyLichKhoiHanh" ? "active" : "")" href="@Url.Action("Index", "QuanlyLichKhoiHanh")">
                <i class="bi bi-calendar-check-fill me-2"></i> Lịch Khởi Hành
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyDatTour" ? "active" : "")" href="@Url.Action("DanhSachDatTour", "QuanlyDatTour")">
                <i class="bi bi-journal-check me-2"></i> Quản lý Đặt Tour
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyNguoidung" ? "active" : "")" href="@Url.Action("Index", "QuanlyNguoidung")">
                <i class="bi bi-people-fill me-2"></i> Quản lý Người dùng
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyMuaGia" ? "active" : "")" href="@Url.Action("Index", "QuanlyMuaGia")">
                <i class="bi bi-tags me-2"></i> Quản lý Mùa Giá
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyChinhSachHuy" ? "active" : "")" href="@Url.Action("Index", "QuanlyChinhSachHuy")">
                <i class="bi bi-shield-exclamation me-2"></i> Chính Sách Hủy
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyYeuCauHuy" ? "active" : "")" href="@Url.Action("Index", "QuanlyYeuCauHuy")">
                <i class="bi bi-x-circle-fill me-2"></i> Yêu Cầu Hủy Tour
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyDiaDiem" ? "active" : "")" href="@Url.Action("Index", "QuanlyDiaDiem")">
                <i class="bi bi-pin-map-fill me-2"></i> Quản lý Địa Điểm
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyDanhMuc" ? "active" : "")" href="@Url.Action("Index", "QuanlyDanhMuc")">
                <i class="bi bi-tags-fill me-2"></i> Quản lý Danh Mục
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyLienHe" ? "active" : "")" href="@Url.Action("Index", "QuanlyLienHe")">
                <i class="bi bi-envelope-paper-fill me-2"></i> Quản lý Liên Hệ
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "QuanlyTinTuc" ? "active" : "")" href="@Url.Action("Index", "QuanlyTinTuc")">
                <i class="bi bi-newspaper me-2"></i> Quản lý Tin tức
            </a>

        </nav>
    </div>

    <main class="content-wrapper pt-5">
        @RenderBody()
        @RenderSection("Scripts", required: false)

    </main>


    <footer>
        <small>© 2025 Du Lịch Việt Admin</small>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).on("click", ".admin-show-more-notifications", function (event) {
            event.preventDefault();
            const panel = $(this).closest(".admin-notification-panel");
            panel.find(".admin-extra-notification").removeClass("d-none");
            $(this).closest(".d-grid").remove();
        });
    </script>
</body>
</html>
