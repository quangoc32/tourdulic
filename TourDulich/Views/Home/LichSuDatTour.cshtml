@model List<TourDulich.ModelView.LichSuDatTourView>

@{
    ViewBag.Title = "Lịch sử đặt tour";
}

<div class="container my-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb shadow-sm bg-white p-3 rounded mb-0" style="font-size: 1rem;">
            <li class="breadcrumb-item">
                <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-primary">
                    Trang chủ
                </a>
            </li>
            <li class="breadcrumb-item active text-dark" aria-current="page">
                <i class="bi bi-chevron-right mx-1"></i>Lịch sử
            </li>
        </ol>
    </nav>
</div>

<div class="container mt-5 pt-1">
    <h2 class="text-center mb-5 text-primary fw-bold">
        <i class="bi bi-clock-history me-2"></i>Lịch sử đặt tour
    </h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center shadow-sm rounded-3">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            Ban chua dat tour nao.
        </div>
    }
    else
    {
        <!-- Chính sách hủy tour -->
        <div class="alert alert-info small mb-4">
            <i class="bi bi-info-circle-fill me-2"></i>
            <strong>Chính sách hủy tour:</strong>
            Yêu cầu hủy chỉ được gửi khi còn <strong>ít nhất 7 ngày</strong> trước ngày khởi hành.
        </div>

        <div class="card shadow border-0 rounded-4">
            <div class="card-header bg-primary text-white rounded-top-4">
                <strong><i class="bi bi-receipt"></i> Danh sách các tour đã đặt</strong>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover text-center align-middle mb-0">
                        <thead class="table-light">
                            <tr class="fw-semibold">
                                <th>Don #</th>
                                <th>Ngay dat</th>
                                <th>Ten tour</th>
                                <th>Ngay khoi hanh</th>
                                <th>Loai dat</th>
                                <th>So nguoi</th>
                                <th>Tong tien</th>
                                <th>Thanh toan</th>
                                <th>Trang thai</th>
                                <th>Tien hoan</th>
                                <th>Yeu cau huy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var don in Model)
                            {
                                int rowCount = don.ChiTietTours.Count;
                                int rowIndex = 0;
                                foreach (var ct in don.ChiTietTours)
                                {
                                    <tr>
                                        @if (rowIndex == 0)
                                        {
                                            <td rowspan="@rowCount">@don.ID_DatTour</td>
                                            <td rowspan="@rowCount">
                                                @(don.NgayDat?.ToString("dd/MM/yyyy"))
                                                @if (don.LaDoan && !string.IsNullOrEmpty(don.TruongDoan))
                                                {
                                                    <br /><small class="text-muted"><i class="bi bi-person-badge"></i> @don.TruongDoan</small>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <div>@ct.TenTour</div>
                                            @if (!string.IsNullOrWhiteSpace(ct.DiemDon))
                                            {
                                                <div class="small text-muted">
                                                    Điểm đón: <strong>@ct.DiemDon</strong>
                                                    @if (ct.CanXacNhanDiemDon)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1">Chờ xác nhận</span>
                                                    }
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(ct.DiaChiDon))
                                            {
                                                <div class="small text-muted">@ct.DiaChiDon</div>
                                            }
                                        </td>
                                        <td>@(ct.NgayKhoiHanh?.ToString("dd/MM/yyyy"))</td>
                                        @if (rowIndex == 0)
                                        {
                                            <td rowspan="@rowCount">
                                                @if (don.LaDoan)
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-people-fill"></i> Doan</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary"><i class="bi bi-person-fill"></i> Khach le</span>
                                                }
                                            </td>
                                        }
                                        <td>@ct.SoLuongNguoi</td>
                                        @if (rowIndex == 0)
                                        {
                                            <td rowspan="@rowCount" class="text-danger fw-bold">@string.Format("{0:N0}", don.TongTien)d</td>
                                        }
                                        <td>@ct.PhuongThucThanhToan</td>
                                        @if (rowIndex == 0)
                                        {
                                            <td rowspan="@rowCount">
                                                @if (don.CoTheThanhToan)
                                                {
                                                    <a href="@Url.Action("ThanhToanDon", "Home", new { id = don.ID_DatTour })" class="btn btn-success btn-sm mb-2">
                                                        <i class="bi bi-credit-card"></i> Thanh toán
                                                    </a>
                                                    <br />
                                                }
                                                @if (don.TrangThai == "Da huy")
                                                {
                                                    <span class="badge bg-danger">Da huy</span>
                                                }
                                                else if (don.TrangThai == "Da xac nhan")
                                                {
                                                    <span class="badge bg-success">Da xac nhan</span>
                                                }
                                                else if (don.TrangThai == "Yêu cầu đoàn - Chờ xác nhận")
                                                {
                                                    <span class="badge bg-warning text-dark">Cho xac nhan doan</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">@don.TrangThai</span>
                                                }
                                            </td>
                                            <td rowspan="@rowCount">
                                                @if (don.TienHoan.HasValue && don.TienHoan.Value > 0)
                                                {
                                                    <span class="text-success fw-bold">@string.Format("{0:N0}", don.TienHoan)d</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td rowspan="@rowCount">
                                                @if (don.TrangThai == "Da huy")
                                                {
                                                    <span class="text-muted small">
                                                        <i class="bi bi-x-circle"></i> Da huy
                                                    </span>
                                                }
                                                else if (don.CoYeuCauHuy)
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        <i class="bi bi-hourglass-split"></i> Dang cho xu ly
                                                    </span>
                                                }
                                                else if (don.CoTheHuy)
                                                {
                                                    <button class="btn btn-outline-danger btn-sm btnYeuCauHuy"
                                                            data-id="@don.ID_DatTour">
                                                        <i class="bi bi-x-circle me-1"></i>Yeu cau huy
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small d-inline-block"
                                                          data-bs-toggle="tooltip"
                                                          data-bs-placement="top"
                                                          title="@don.LyDoKhongTheHuy"
                                                          style="cursor:help; border-bottom:1px dotted #999">
                                                        <i class="bi bi-lock me-1"></i>Khong the huy
                                                    </span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                    rowIndex++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="card-footer text-end bg-light rounded-bottom-4 px-4 py-3">
                <strong class="me-2">Tong tien toan bo:</strong>
                <span class="fs-5 fw-bold text-danger">
                    @string.Format("{0:N0}", Model.Sum(d => d.TongTien))d
                </span>
            </div>
        </div>
    }
</div>

<!-- Modal Yeu cau huy -->
<div class="modal fade" id="modalYeuCauHuy" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:15px">
            <div class="modal-header bg-danger text-white" style="border-radius:15px 15px 0 0">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận hủy tour
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            @using (Html.BeginForm("GuiYeuCauHuy", "Home", FormMethod.Post, new { id = "formYeuCauHuy" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ID_DatTour" id="huyDonId" />
                <div class="modal-body p-4">
                    <div class="alert alert-warning small">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        Yêu cầu hủy của bạn sẽ được <strong>chờ Admin xét duyệt</strong>. Tiền hoàn lại sẽ được xử lý sau khi được chấp thuận.
                    </div>
                    
                    <!-- Loading State -->
                    <div id="loadingHuyTour" class="text-center py-4">
                        <div class="spinner-border text-danger mb-2" role="status"></div>
                        <p class="text-muted small">Đang tính toán chính sách hủy áp dụng...</p>
                    </div>

                    <!-- Data State -->
                    <div id="thongTinHuyTour" style="display:none;">
                        <div class="alert alert-light border border-secondary-subtle small mb-3">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <td class="text-muted"><i class="bi bi-clock me-1"></i>Thời gian còn lại:</td>
                                    <td class="text-end fw-bold text-danger"><span id="huySoNgay"></span> ngày</td>
                                </tr>
                                <tr>
                                    <td class="text-muted"><i class="bi bi-shield-check me-1"></i>Chính sách áp dụng:</td>
                                    <td class="text-end fw-bold text-success"><span id="huyChinhSach"></span></td>
                                </tr>
                                <tr class="border-top">
                                    <td class="text-muted pt-2"><i class="bi bi-cash-coin me-1"></i>Dự kiến hoàn tiền:</td>
                                    <td class="text-end fw-bold text-danger pt-2 fs-6">
                                        <span id="huyTienHoan"></span> VNĐ <small class="text-muted">(<span id="huyPhanTram"></span>%)</small>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                Lý do hủy <span class="text-danger">*</span>
                            </label>
                            <textarea name="LyDo" class="form-control" rows="2"
                                      placeholder="VD: Thay đổi kế hoạch, bận công việc đột xuất..." required></textarea>
                        </div>

                        <div class="border rounded p-3 bg-light-subtle">
                            <div class="fw-bold mb-2">
                                <i class="bi bi-bank me-1"></i> Tài khoản ngân hàng nhận hoàn tiền
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Ngân hàng <span class="text-danger">*</span></label>
                                <input type="text" name="TenNganHang" class="form-control" placeholder="VD: Vietcombank, BIDV, Techcombank..." required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Số tài khoản <span class="text-danger">*</span></label>
                                <input type="text" name="SoTaiKhoanHoanTien" class="form-control" placeholder="VD: 0123456789" required />
                            </div>
                            <div class="mb-0">
                                <label class="form-label fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                                <input type="text" name="TenChuTaiKhoan" class="form-control" placeholder="VD: NGUYEN VAN A" required />
                            </div>
                        </div>
                    </div>
                    
                    <!-- Error State -->
                    <div id="errorHuyTour" class="alert alert-danger small mb-0" style="display:none;"></div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4" id="btnSubmitHuy" disabled>
                        <i class="bi bi-check-circle me-1"></i> Xác nhận hủy
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    // Khởi tạo tooltip Bootstrap
    var tooltipEls = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    tooltipEls.forEach(function (el) { new bootstrap.Tooltip(el); });

    // Mở modal yêu cầu hủy
    $(".btnYeuCauHuy").click(function () {
        var id = $(this).data("id");
        $("#huyDonId").val(id);
        $("textarea[name='LyDo']").val("");
        
        // Reset states
        $("#loadingHuyTour").show();
        $("#thongTinHuyTour").hide();
        $("#errorHuyTour").hide();
        $("#btnSubmitHuy").prop("disabled", true);
        
        $("#modalYeuCauHuy").modal("show");

        // Gọi API lấy thông tin
        $.ajax({
            url: '@Url.Action("GetThongTinHuy", "Home")',
            type: 'GET',
            data: { id: id },
            success: function(res) {
                $("#loadingHuyTour").hide();
                if (res.success) {
                    // Hiển thị thông tin
                    $("#huySoNgay").text(res.soNgayConLai);
                    $("#huyChinhSach").text(res.chinhSachText);
                    $("#huyPhanTram").text(res.phanTram);
                    $("#huyTienHoan").text(res.tienHoan.toLocaleString("vi-VN"));
                    
                    $("#thongTinHuyTour").fadeIn();
                    $("#btnSubmitHuy").prop("disabled", false);
                } else {
                    // Lỗi từ server (vd: quá hạn)
                    $("#errorHuyTour").html("<i class='bi bi-x-octagon-fill me-2'></i>" + res.message).fadeIn();
                }
            },
            error: function() {
                $("#loadingHuyTour").hide();
                $("#errorHuyTour").html("<i class='bi bi-x-octagon-fill me-2'></i>Có lỗi xảy ra khi kết nối máy chủ.").fadeIn();
            }
        });
    });
});
</script>
}
