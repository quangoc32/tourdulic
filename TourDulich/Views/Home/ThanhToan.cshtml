@model TourDulich.ModelView.ThanhToanView
@using TourDulich.Models

@{
    ViewBag.Title = "Thanh Toán Đặt Tour";
    var tongTien = Model.DanhSachTour.Sum(t => ((t.GiaThucTe ?? t.Gia ?? 0) + (t.PhuThuDiemDon ?? 0)) * t.SoLuong);
    var noiDungChuyenKhoan = Model.ID_DatTour.HasValue ? "DAT TOUR " + Model.ID_DatTour.Value : "DAT TOUR " + Model.UserInfo.ID_NguoiDung;
    var formAction = Model.ID_DatTour.HasValue ? Url.Action("XacNhanThanhToanDon", "Home") : Url.Action("ThanhToan", "Home");
}

<div class="container my-4">
    <h3 class="mb-4">Thông tin khách hàng</h3>
    <form action="@formAction" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        @if (Model.ID_DatTour.HasValue)
        {
            <input type="hidden" name="ID_DatTour" value="@Model.ID_DatTour.Value" />
        }

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="HoTen" class="form-label fw-semibold">Họ tên</label>
                <input type="text" id="HoTen" name="UserInfo.HoTen" class="form-control" value="@Model.UserInfo.HoTen" readonly />
            </div>
            <div class="col-md-6">
                <label for="Email" class="form-label fw-semibold">Email</label>
                <input type="email" id="Email" name="UserInfo.Email" class="form-control" value="@Model.UserInfo.Email" readonly />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label for="SoDienThoai" class="form-label fw-semibold">Số điện thoại</label>
                <input type="text" id="SoDienThoai" name="UserInfo.SoDienThoai" class="form-control" value="@Model.UserInfo.SoDienThoai" readonly />
            </div>
            <div class="col-md-6">
                <label for="DiaChi" class="form-label fw-semibold">Địa chỉ</label>
                <input type="text" id="DiaChi" name="UserInfo.DiaChi" class="form-control" value="@Model.UserInfo.DiaChi" readonly />
            </div>
        </div>

        <h3 class="mt-5 mb-3">Thanh toán chuyển khoản</h3>
        <input type="hidden" name="PhuongThucThanhToan" value="@AppConstants.ThanhToan.ChuyenKhoan" />
        <div class="border rounded p-3 mb-4 bg-light">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Ngân hàng</div>
                    <div class="fs-5">@AppConstants.ThongTinChuyenKhoan.NganHang</div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Số tài khoản</div>
                    <div class="fs-5">@AppConstants.ThongTinChuyenKhoan.SoTaiKhoan</div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Chủ tài khoản</div>
                    <div class="fs-5">@AppConstants.ThongTinChuyenKhoan.ChuTaiKhoan</div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Chi nhánh</div>
                    <div class="fs-5">@AppConstants.ThongTinChuyenKhoan.ChiNhanh</div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Số tiền</div>
                    <div class="fs-5 text-success fw-bold">@string.Format("{0:N0}₫", tongTien)</div>
                </div>
                <div class="col-md-6">
                    <div class="fw-semibold text-muted">Nội dung chuyển khoản</div>
                    <div class="fs-5 fw-bold">@noiDungChuyenKhoan</div>
                </div>
            </div>
        </div>

        <h3 class="mt-5 mb-3">Danh sách tour</h3>
        <div class="table-responsive">
            <table class="table table-bordered align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>Tên tour</th>
                        <th>Ngày khởi hành</th>
                        <th>Số lượng</th>
                        <th>Giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tour in Model.DanhSachTour)
                    {
                        <tr>
                            <td class="text-start">@tour.TenTour</td>
                            <td>@tour.NgayDi.ToString("dd/MM/yyyy")</td>
                            <td>@tour.SoLuong</td>
                            <td class="text-end text-primary fw-semibold">@string.Format("{0:N0}₫", (tour.GiaThucTe ?? tour.Gia) + (tour.PhuThuDiemDon ?? 0))</td>
                            <td class="text-end fw-bold text-success">@string.Format("{0:N0}₫", tour.ThanhTienCoDiemDon)</td>
                        </tr>
                        <tr>
                            <td colspan="5" class="text-start text-muted small">
                                Điểm đón: <strong>@tour.DiemDon</strong>
                                @if (!string.IsNullOrWhiteSpace(tour.DiaChiDon))
                                {
                                    <span> - @tour.DiaChiDon</span>
                                }
                                @if (tour.CanXacNhanDiemDon)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Chờ admin xác nhận</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end fw-bold fs-5">Tổng tiền:</td>
                        <td class="text-end fw-bold fs-5 text-success">
                            @string.Format("{0:N0}₫", tongTien)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-success btn-lg px-5 fw-semibold">
                <i class="bi bi-credit-card me-2"></i> Xác nhận đã chuyển khoản
            </button>
        </div>
    </form>
</div>
