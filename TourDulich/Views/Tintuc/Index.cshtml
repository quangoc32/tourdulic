@model List<TourDulich.ModelView.TinTucLinkView>

@{
    ViewBag.Title = "Tin tức";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h3 class="fw-bold">Tin tức & Cẩm nang du lịch</h3>
        <p class="text-muted">Cập nhật thông tin du lịch, kinh nghiệm và các chủ đề đang được quan tâm</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center">Chưa có tin tức nào được hiển thị.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                var image = string.IsNullOrWhiteSpace(item.HinhAnh)
                    ? "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=800&q=80"
                    : item.HinhAnh;

                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@image" class="card-img-top" alt="@item.TieuDe" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <h5 class="card-title mb-0">@item.TieuDe</h5>
                                @if (item.LaTinHot)
                                {
                                    <span class="badge bg-danger">Hot</span>
                                }
                            </div>
                            <p class="card-text text-muted small">@item.MoTaNgan</p>
                            @if (!string.IsNullOrWhiteSpace(item.Nguon))
                            {
                                <div class="small text-secondary mb-3">Nguồn: @item.Nguon</div>
                            }
                            <a href="@item.LinkBaiViet" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mt-auto">Xem thêm</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
